generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Scene {
  id         String   @id @default(cuid())
  title      String
  durationMs Int      @default(4000)
  data       String
  thumb      String?
  starred    Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}
