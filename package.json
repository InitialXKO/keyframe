{
  "name": "keyframe-engine",
  "version": "1.0.0",
  "description": "WASM Keyframe Animation Engine with WGSL Compute & Remotion Compat Layer",
  "type": "module",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./three": {
      "import": "./dist/adapters/three_adapter.js",
      "types": "./dist/adapters/three_adapter.d.ts"
    },
    "./webgpu": {
      "import": "./dist/adapters/webgpu_adapter.js",
      "types": "./dist/adapters/webgpu_adapter.d.ts"
    },
    "./dom": {
      "import": "./dist/dom_binder.js",
      "types": "./dist/dom_binder.d.ts"
    },
    "./controller": {
      "import": "./dist/controller.js",
      "types": "./dist/controller.d.ts"
    },
    "./math": {
      "import": "./dist/math/hierarchy.js",
      "types": "./dist/math/hierarchy.d.ts"
    },
    "./physics": {
      "import": "./dist/physics/RealTimeSpring.js",
      "types": "./dist/physics/RealTimeSpring.d.ts"
    }
  },
  "scripts": {
    "build:shaders": "node scripts/embed-shaders.js",
    "build:wasm": "wasm-pack build --target web --out-dir pkg",
    "build:ts": "npm run build:shaders && tsc",
    "build": "npm run build:shaders && npm run build:wasm && npm run build:ts",
    "publish:monorepo": "pnpm publish --filter @keyframe/core && pnpm publish --filter @keyframe/controller && pnpm publish --filter @keyframe/three && pnpm publish --filter @keyframe/webgpu && pnpm publish --filter @keyframe/dom && pnpm publish --filter @keyframe/math && pnpm publish --filter @keyframe/physics",
    "test:rs": "cargo test",
    "test:js": "node --test tests/**/*.test.js tests/**/*.test.mjs 2>/dev/null || node --test",
    "test": "npm run test:rs && npm run test:js"
  },
  "overrides": {
    "@keyframe/core": "^1.0.0",
    "@keyframe/controller": "^1.0.0",
    "@keyframe/three": "^1.0.0",
    "@keyframe/webgpu": "^1.0.0",
    "@keyframe/dom": "^1.0.0",
    "@keyframe/math": "^1.0.0",
    "@keyframe/physics": "^1.0.0"
  },
  "devDependencies": {
    "typescript": "^5.9.3"
  }
}
